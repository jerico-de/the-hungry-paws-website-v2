<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    <!-- ADMIN TOP BAR -->
    <header class="user-topbar">
      <div class="user-topbar-left">
        <button class="dashboard-menu-toggle" id="dashboardMenuToggle">
          <span></span><span></span><span></span>
        </button>
        <img src="/images/logo.png" alt="The Hungry Paws" class="user-logo" />
        <span class="welcome-text">
          Welcome, <strong><%= user.fullName %></strong> (Admin)
        </span>
      </div>
    </header>

    <!-- DASHBOARD LAYOUT -->
    <div class="dashboard">
      <aside class="sidebar" id="dashboardSidebar">
        <button class="sidebar-link active" data-section="dashboard">Dashboard</button>
        <button class="sidebar-link" data-section="profile">Profile</button>
        <button class="sidebar-link" data-section="bookings">Bookings</button>
        <button class="sidebar-link" data-section="employees">Employees</button>
        <button class="sidebar-link" data-section="duty">On Duty</button>
        <button class="sidebar-link" data-section="leave">Leave Requests</button>
        <button class="sidebar-link" data-section="messages">Messages</button>

        <form action="/logout" method="POST" class="logout-form">
          <button type="submit" class="sidebar-link logout-btn">Logout</button>
        </form>
      </aside>

      <div class="dashboard-overlay" id="dashboardOverlay"></div>

      <main class="dashboard-content" id="dashboardContent"
            data-email="<%= user.email %>"
            data-name="<%= user.fullName %>"
            data-contact="<%= user.contact || '' %>"
            data-address="<%= user.address || '' %>"
            data-joined="<%= user.createdAt ? user.createdAt.toISOString() : '' %>">
      </main>
    </div>

    <script>
      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get("token");
      if (token) {
        sessionStorage.setItem("jwtToken", token);
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    </script>
    <script src="/js/upload.helper.js"></script>
    <script src="js/admin.js"></script>
  </body>
</html>